{
  "name": "dalga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:artifact": "vite build && node scripts/artifact.mjs",
    "typecheck": "tsc --noEmit",
    "economy": "esbuild scripts/economy-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/economy.mjs --log-level=warning && node node_modules/.cache/economy.mjs",
    "sim-test": "esbuild scripts/sim-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim-test.mjs --log-level=warning && node node_modules/.cache/sim-test.mjs"
  },
  "dependencies": {
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/three": "0.183.1",
    "esbuild": "0.25.12",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
