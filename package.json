{
  "name": "kesit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim-test": "esbuild scripts/sim-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim-test.mjs --log-level=warning && node node_modules/.cache/sim-test.mjs",
    "build:artifact": "vite build && node scripts/artifact.mjs",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/balance.mjs --log-level=warning && node node_modules/.cache/balance.mjs"
  },
  "dependencies": {
    "pixi-filters": "^6.1.1",
    "pixi.js": "^8.6.6",
    "planck": "^1.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
