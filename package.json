{
  "name": "underfoot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "headless": "esbuild scripts/headless.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/headless.mjs --log-level=warning && node node_modules/.cache/headless.mjs",
    "build:artifact": "vite build && node scripts/artifact.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vite": "~6.4.4"
  }
}
